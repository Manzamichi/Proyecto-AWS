# ---- Base de datos RDS (MySQL) ----
DB_USER=admin
DB_PASSWORD=tu_password_rds
DB_HOST=tu-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=sicei

# ---- AWS (credenciales del botón "AWS Details" del laboratorio) ----
# En EC2 con IAM Role puedes dejar estas tres vacías y boto3 usará el rol.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# ---- S3 ----
S3_BUCKET_NAME=tu-bucket-publico

# ---- SNS ----
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:notificaciones-alumnos

# ---- Lambda ----
LAMBDA_FUNCTION_NAME=notificar-alumno

# ---- DynamoDB ----
DYNAMO_TABLE=sesiones-alumnos
